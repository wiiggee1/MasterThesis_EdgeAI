.{
    // It is redundant to include "zig" in this name because it is already
    // within the Zig package namespace.
    .name = .main,

    // .version = "0.0.1",
    .version = "0.0.1",

    // Tracks the earliest Zig version that the package considers to be a
    // supported use case.
    .minimum_zig_version = "0.15.1",

    .dependencies = .{
        // See `zig fetch --save <url>` for a command-line interface for adding dependencies.
    },

    .paths = .{
        "examples",
        "config",
        "scripts",
        "docs",
        "build.zig",
        "build.zig.zon",
        "src",
        "src/model",
        // For example...
        "LICENSE",
        "README.md",
    },
    
    .fingerprint = 0xbf28cd6421fd20c6,
    // .fingerprint = 0x6b8d854f28d25dcd, // Changing this has security and trust implications.
}
